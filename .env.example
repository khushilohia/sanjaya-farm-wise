# --- AI (required for assistant, disease detection, soil interpretation) ---
# https://platform.openai.com/api-keys
OPEN_AI_API_KEY=

# --- Voice (required for speech-to-text fallback and text-to-speech) --------
# https://dashboard.sarvam.ai
SARVAM_AI_API_KEY=

# Super admin access for /admin — comma-separated phone numbers of admin accounts
ADMIN_PHONES=

# --- Auth (required) ---------------------------------------------------------
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=

# --- Database ----------------------------------------------------------------
# Local dev: omit both — defaults to file:./data/sanjaya.db (SQLite, zero setup).
# Production (Vercel is stateless): use Turso — https://turso.tech
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# --- Market prices (optional) --------------------------------------------------
# Live Agmarknet mandi prices. Without it, prices fall back to AI estimates.
# https://data.gov.in
DATA_GOV_IN_API_KEY=
